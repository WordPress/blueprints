{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Block Editor Creator Lab",
		"description": "Laboratorio guiado en espanol para practicar estructura de informacion, bloques, patrones, plantillas y estilos globales en WordPress.",
		"author": "fellyph",
		"categories": ["Education", "Content", "Block Editor"]
	},
	"landingPage": "/creator-lab/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.0"
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Block Editor Creator Lab",
				"blogdescription": "Practica estructura, bloques, patrones y estilos globales."
			}
		},
		{
			"step": "installTheme",
			"ifAlreadyInstalled": "overwrite",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/fellyph/learn-creator-lab",
				"ref": "main",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "learn-creator-lab"
			},
			"progress": {
				"weight": 2,
				"caption": "Installing the Learn Creator Lab block theme"
			}
		},
		{
			"step": "writeFile",
			"path": "/tmp/creator-lab-setup.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/wordpress/blueprints/codex/block-editor-creator-lab/blueprints/block-editor-creator-lab/setup.php"
			},
			"progress": {
				"weight": 1,
				"caption": "Downloading the Creator Lab exercise setup"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/tmp/creator-lab-setup.php';",
			"progress": {
				"weight": 4,
				"caption": "Publishing the exercise hub and editable starter drafts"
			}
		}
	]
}
