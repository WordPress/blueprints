{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "HabitForge",
		"description": "A private habit tracker. Daily check-ins, streaks, and GitHub-style heatmaps — all stored locally in your own WordPress.",
		"author": "muryamsultana",
		"categories": ["Apps", "Productivity"]
	},
	"landingPage": "/habits/",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/plugins/habitforge"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/habitforge/habitforge.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/blueprints/trunk/blueprints/habitforge/habitforge.php"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "/plugin/habitforge.php"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "HabitForge",
				"blogdescription": "Build habits, one day at a time"
			}
		}
	]
}
