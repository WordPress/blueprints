{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Hello Blueprints: A Learning Sandbox",
    "author": "supernovia",
    "description": "A starter blueprint. Installs a plugin, a theme, clears default content, and imports a wxr.",
    "categories": ["Learning", "Demo"]
  },
  "login": true,
  "landingPage": "/",
  "siteOptions": {
    "blogname": "Hello Blueprints"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "hello-dolly"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyfive"
      }
    },
    {
      "step": "resetData"
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/supernovia/blueprints/trunk/blueprints/hello-blueprints/welcome.wxr"
      }
    }
  ]
}
