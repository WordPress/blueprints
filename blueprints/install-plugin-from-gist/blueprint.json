{
	"meta": {
		"title": "Install plugin from a PHP file",
		"author": "zieladam",
		"description": "Install and activate a WordPress plugin from a single .php file downloaded over the network.",
		"categories": ["plugins"]
	},
	"landingPage": "/wp-admin/plugins.php",
	"preferredVersions": {
		"wp": "beta",
		"php": "8.3"
	},
	"login": true,
	"steps": [
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/0-plugin.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/blueprints/fix/blueprint-validation-failures/blueprints/install-plugin-from-gist/block-hooks-demo.php"
			}
		},
		{
			"step": "activatePlugin",
			"pluginName": "Block Hooks Demo",
			"pluginPath": "0-plugin.php"
		}
	]
}
