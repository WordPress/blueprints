{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Koinonia",
		"description": "A blueprint for the Koinonia theme, see https://koinoniademo.wordpress.com/?demo",
		"author": "WordPress.com"
	},
	"login": true,
	"siteOptions": {
		"blogname": "Koinonia"
	},
	"steps": [
		{
			"step": "resetData"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "bundled",
				"path": "./koinonia.zip"
			},
			"options": {
				"activate": true
			}
		}
	]
}
