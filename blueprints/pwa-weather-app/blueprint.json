{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "latest",
    "wp": "latest"
  },
  "siteOptions": {
    "blogname": "Weather PWA",
    "blogdescription": "Real-time weather app via OpenWeatherMap API"
  },
  "plugins": [
    "super-progressive-web-apps"
  ],
  "steps": [
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/plugins/weather-api"
    },
    {
        "step": "writeFile",
        "path": "/wordpress/wp-content/plugins/weather-api/weather-api.php",
        "data": {
                "resource": "path",
                "url": "/weather.php"
        }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/weather-api/weather-api.php"
    }
  ],
  "features": {
    "networking": true
  },
  "login": true,
  "landingPage": "/"
}